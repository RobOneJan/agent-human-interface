# The Anthropic SDK resolves credentials itself (ANTHROPIC_API_KEY,
# ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile) - no field for it here.
# For a headless deployment, set:
# ANTHROPIC_API_KEY=

# From @BotFather on Telegram (/newbot). Unused while main.py runs
# teams_bot.py instead of telegram_bot.py - see README.
TELEGRAM_BOT_TOKEN=

# --- Microsoft Teams / Bot Framework (see teams_bot.py) ---
# One Azure AD (Entra ID) single-tenant app registration, doubling as both
# this Bot's own identity and the Graph on-behalf-of client used by
# email-mcp-server's GRAPH_CLIENT_ID/GRAPH_TENANT_ID (same values). Needs an
# Azure Bot resource (Teams channel enabled) with an "Azure Active Directory
# v2" OAuth Connection Setting named "graph", Token Exchange URL set to this
# app's Application ID URI, and scopes "Mail.ReadWrite Mail.Send
# offline_access openid profile User.Read" - see README's Azure setup steps.
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=

# Real HTTP port teams_bot.py's aiohttp app listens on (POST /api/messages).
PORT=8080

# "<name>=<url>,<name>=<url>,..." - one MCP server per entry. Local dev via
# `gcloud run services proxy` (see email-mcp-server's README):
MCP_SERVERS=email=http://localhost:8080/mcp
# Hosted, once this itself is deployed with a service account granted
# roles/run.invoker on email-mcp-server:
# MCP_SERVERS=email=https://<cloud-run-url>/mcp

# Comma-separated Telegram chat ids allowed to use this bot. Unused while
# Teams is the active channel (see above) - no self-serve
# signup - this is the access-control list. Find your chat id via
# https://t.me/userinfobot or by checking the logs after messaging the bot once.
#
# Each entry is "<chat_id>" or "<chat_id>=<tenant_id>". A bare chat_id maps to
# tenant "default" (this bot's original single mailbox on the email MCP
# server). Use "<chat_id>=<tenant_id>" to route a different chat to a
# different mailbox on the same shared bot - the target email-mcp-server must
# have that tenant onboarded via its own scripts/gmail_auth.py or
# scripts/imap_auth.py --tenant <tenant_id> (see that repo's README).
# Example: TELEGRAM_ALLOWED_CHAT_IDS=8811142957,123456789=friend-terbox
TELEGRAM_ALLOWED_CHAT_IDS=

# Stepped down from claude-opus-5 for cost - see README "Cost". Bump back up
# if quality doesn't hold for your traffic.
CLAUDE_MODEL=claude-sonnet-5

# low | medium | high | xhigh | max
CLAUDE_EFFORT=low
